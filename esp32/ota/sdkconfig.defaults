# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA rollback — must be enabled for PENDING_VERIFY state machine
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Anti-rollback via security version counter in eFuse
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SEC_VER=1

# Reject plain-HTTP OTA targets at build time
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# Use the full CA bundle so the server cert validates against real CAs.
# Replace with CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n and embed your own
# CA cert (server_cert.pem) for tighter pinning in production.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# TLS
CONFIG_MBEDTLS_TLS_CLIENT=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# Watchdog
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Panic: reboot, don't halt
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
